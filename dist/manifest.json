{
  "manifest_version": 3,
  "name": "WebPenter Meet Standup & EOD Leaderboard",
  "version": "1.0.0",
  "description": "Google Meet Standup & EOD attendance tracker, $WP punctuality scoring, weekly & monthly leaderboards with 1-click Slack reports.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://hooks.slack.com/*"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "extension/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebPenter Standup & EOD Leaderboard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
